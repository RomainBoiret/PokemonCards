# -----------------------------------------------------------------------------
# PokePark - Java / Swing / jpackage
# -----------------------------------------------------------------------------

# Compiled Java output
*.class
*.jmod
out/
target/
build/
bin/

# Application artifacts
dist/
release/
releases/
package-input/

# jpackage temporary/output directories
.jpackage/
PokePark-*/

# Keep the vendored runtime dependency used by build scripts
!lib/
!lib/json-simple-1.1.1.jar

# Java crash and profiling files
hs_err_pid*
replay_pid*
*.hprof
*.jfr

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Local save data (the real save normally lives in the user's home directory)
.pokepark/
save.json
save.json.tmp

# Environment variables and local secrets
.env
.env.*
!.env.example
*.secret
*.secrets

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse / Java language server
.classpath
.project
.settings/
.factorypath
.apt_generated/
.apt_generated_tests/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# VS Code: keep shared Java settings, ignore local workspace state
.vscode/*
!.vscode/settings.json
*.code-workspace

# Gradle / Maven (future-proofing)
.gradle/
.mvn/timing.properties
dependency-reduced-pom.xml

# Test and coverage reports
coverage/
reports/
test-results/
surefire-reports/
jacoco.exec

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# Linux editor / desktop metadata
.directory
.Trash-*

# Windows shortcuts and installer leftovers
*.lnk
*.msi
*.msix
*.appx

# Archives generated for GitHub Releases
*.zip
*.tar
*.tar.gz
*.tgz
